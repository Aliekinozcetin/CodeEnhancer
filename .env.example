# CodeEnhancer — Configuration Template
# Copy this file as .env and configure your variables.
# NEVER commit the actual .env file to Git!

# Ollama local base URL and model mappings
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_1=qwen2.5-coder:7b
OLLAMA_MODEL_2=llama3.1:8b
OLLAMA_MODEL_3=gemma2:9b

# External LLM Judge (required for GPT-4o-mini validation)
OPENAI_API_KEY=your-openai-api-key-here
